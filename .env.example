# =============================================================================
# SalesOS — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit real keys. The .env file is gitignored.
# =============================================================================

# --- Supabase (Required) ---
# Get these from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- JVecom B2B Orders API Integration ---
# Recommended for Web App (Bypasses Browser CORS): /api/jvecom
# Direct Edge Gateway: https://wokqhsfrncvswtnukdou.supabase.co/functions/v1/orders-api/v1
# Production Gateway: https://www.jvecomb2b.com/api/v1
VITE_JVECOM_API_URL=/api/jvecom
VITE_JVECOM_API_KEY=

# --- App Configuration ---
VITE_APP_NAME=SalesOS
VITE_APP_ENV=development
# Options: development | staging | production
