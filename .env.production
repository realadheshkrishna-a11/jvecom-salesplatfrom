# =============================================================================
# SalesOS — Production Environment
# =============================================================================
# These are compile-time defaults for production builds.
# Override with real values in your hosting provider (Vercel, Netlify, etc.)
# =============================================================================

VITE_APP_NAME=SalesOS
VITE_APP_ENV=production

# --- JVecom B2B Orders API Integration ---
# Production uses same relative proxy path rewritten by vercel.json to prevent CORS errors
VITE_JVECOM_API_URL=/api/jvecom
# VITE_JVECOM_API_KEY=jvec_live_...

# --- Supabase (Override these in your hosting provider) ---
# VITE_SUPABASE_URL=https://your-production-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-production-anon-key
